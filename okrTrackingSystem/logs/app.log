        ag1_1.department_id,
        ag1_1.leader_id,
        ag1_1.name,
        ag1_1.updated_at 
    from
        group_members ag1_0 
    join
        org_groups ag1_1 
            on ag1_1.id=ag1_0.group_id 
    where
        ag1_0.user_id=?
